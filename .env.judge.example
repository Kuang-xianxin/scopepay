# Local, synthetic simulation. Does not read the project .env or provider environment.
PAYMENT_MODE=simulation
APP_URL=http://127.0.0.1:18216
DATABASE_PATH=data/judge/scopepay.db
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Optional: use only an authorized running loopback model. No model is downloaded or started.
OPENAI_BASE_URL=http://127.0.0.1:11436/v1
OPENAI_MODEL=
OPENAI_API_KEY=local-not-secret
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=1536
MODEL_SOURCE_MAX_CHARS=2000
