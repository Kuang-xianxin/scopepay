# Copy to .env for a new installation. Never copy somebody else's credentials.
PAYMENT_MODE=simulation
APP_URL=http://127.0.0.1:8215
DATABASE_PATH=data/scopepay.db
# PostgreSQL: use a private JSON config with host,port,database,test_database,username,password,sslmode.
# SCOPEPAY_PG_CONFIG=D:/private/paypal.json
# Or explicitly set SCOPEPAY_DATABASE_URL in this ignored file.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Only the authorized shared loopback inference endpoint is supported.
OPENAI_BASE_URL=http://127.0.0.1:11436/v1
OPENAI_MODEL=
OPENAI_API_KEY=local-not-secret
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=1536
MODEL_SOURCE_MAX_CHARS=2000
