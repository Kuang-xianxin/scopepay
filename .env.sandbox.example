# Private copy outside the public source. Sandbox only. Fill after personal account setup.
PAYMENT_MODE=sandbox
APP_URL=http://127.0.0.1:18216
DATABASE_PATH=data/sandbox/scopepay.db
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The app's Sandbox seller account, not a supplier name or arbitrary payout destination.
PAYPAL_MERCHANT_ID=
# Optional for local manual GET reconciliation; live webhooks need an authorized HTTPS receiver.
PAYPAL_WEBHOOK_ID=
OPENAI_BASE_URL=http://127.0.0.1:11436/v1
OPENAI_MODEL=
OPENAI_API_KEY=local-not-secret
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_TOKENS=1536
MODEL_SOURCE_MAX_CHARS=2000
